# ============================================
# Smart Inventory & Logistics System
# Environment Configuration
# ============================================

# --------------------------------------------
# Database (Required)
# --------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_inventory?schema=public"

# --------------------------------------------
# NextAuth.js (Required)
# --------------------------------------------
# Your app URL (must match the URL you access the app from)
NEXTAUTH_URL="http://localhost:3000"

# Secret key for JWT encryption (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production-min-32-chars"

# --------------------------------------------
# Cloudinary (Optional - for image uploads)
# --------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --------------------------------------------
# Application Settings
# --------------------------------------------
APP_NAME="Smart Inventory & Logistics System"
APP_URL="http://localhost:3000"
APP_ENV="development"

# --------------------------------------------
# Session Settings
# --------------------------------------------
SESSION_MAX_AGE="2592000"
SESSION_UPDATE_AGE="86400"

# --------------------------------------------
# Security
# --------------------------------------------
# Enable/disable registration
ENABLE_REGISTRATION="true"

# Max login attempts before lockout
MAX_LOGIN_ATTEMPTS="5"

# Lockout duration in minutes
LOCKOUT_DURATION="30"

# --------------------------------------------
# Email (Optional - for email notifications)
# --------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# --------------------------------------------
# Feature Flags
# --------------------------------------------
ENABLE_EMAIL_NOTIFICATIONS="false"
ENABLE_AUTO_APPROVAL="false"
ENABLE_QR_CODES="true"
ENABLE_BARCODE="true"

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="60000"

# --------------------------------------------
# Backup Settings
# --------------------------------------------
BACKUP_RETENTION_DAYS="30"
AUTO_BACKUP="false"
BACKUP_SCHEDULE="0 2 * * *"

# --------------------------------------------
# Development Only
# --------------------------------------------
# Show detailed error messages
DEBUG="false"

# Prisma logging
PRISMA_LOG_LEVEL="info"

# Next.js telemetry
NEXT_TELEMETRY_DISABLED="1"