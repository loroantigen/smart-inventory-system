generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role       @default(USER)
  status        UserStatus @default(PENDING)
  departmentId  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  department    Department? @relation(fields: [departmentId], references: [id])

  assignedItems    InventoryAssignment[]
  createdRequests  ConsumableRequest[]   @relation("CreatedRequests")
  approvedRequests ConsumableRequest[]   @relation("ApprovedRequests")
  auditLogs        AuditLog[]
  notifications    Notification[]
  stockMovements   StockMovement[]

  // ✅ NEW: User consumable inventory relations
  consumableInventory UserConsumableInventory[]
  distributions       UserDistribution[]

  @@index([email])
  @@index([departmentId])
  @@index([role])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  inventoryItems  InventoryItem[]
  consumableItems ConsumableItem[]
}

model InventoryItem {
  id                 String          @id @default(cuid())
  propertyNumber     String          @unique
  itemName           String
  description        String?
  category           ItemCategory
  brand              String?
  model              String?
  serialNumber       String?         @unique
  departmentId       String?
  assignedUserId     String?
  fundCode           String?
  fundSource         String?
  supplier           String?
  purchaseDate       DateTime?
  purchaseCost       Decimal?        @db.Decimal(10, 2)
  warrantyExpiration DateTime?
  status             InventoryStatus @default(AVAILABLE)
  qrCode             String?
  barcode            String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  department  Department?           @relation(fields: [departmentId], references: [id])
  assignments InventoryAssignment[]
  documents   InventoryDocument[]

  @@index([propertyNumber])
  @@index([departmentId])
  @@index([status])
  @@index([category])
  @@index([assignedUserId])
}

model InventoryAssignment {
  id                    String    @id @default(cuid())
  inventoryItemId       String
  userId                String
  assignedBy            String
  assignedAt            DateTime  @default(now())
  returnedAt            DateTime?
  condition             String?
  notes                 String?
  acknowledgmentReceipt String?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([userId])
}

model InventoryDocument {
  id              String   @id @default(cuid())
  inventoryItemId String
  fileName        String
  fileUrl         String
  fileType        String
  fileSize        Int
  uploadedBy      String
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
}

model ConsumableItem {
  id             String    @id @default(cuid())
  propertyNumber String    @unique
  itemName       String
  category       String
  description    String?
  quantity       Int       @default(0)
  unitType       String
  batchNumber    String?
  expirationDate DateTime?
  reorderLevel   Int       @default(10)
  criticalLevel  Int       @default(5)
  departmentId   String?
  fundCode       String?
  fundSource     String?
  supplier       String?
  dateReceived   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  department      Department?               @relation(fields: [departmentId], references: [id])
  stockMovements  StockMovement[]
  requests        ConsumableRequest[]
  batches         ConsumableBatch[]

  // ✅ NEW: back-relation to user inventories
  userInventories UserConsumableInventory[]

  @@index([propertyNumber])
  @@index([departmentId])
  @@index([quantity])
  @@index([expirationDate])
}

model ConsumableBatch {
  id               String      @id @default(cuid())
  consumableItemId String
  batchNumber      String
  quantity         Int         @default(0)
  expirationDate   DateTime?
  receivedAt       DateTime    @default(now())
  status           BatchStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  consumableItem ConsumableItem  @relation(fields: [consumableItemId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([consumableItemId])
  @@index([expirationDate])
  @@index([status])
}

model StockMovement {
  id                String          @id @default(cuid())
  consumableItemId  String
  consumableBatchId String?
  type              MovementType
  quantity          Int
  previousQuantity  Int
  newQuantity       Int
  reason            String?
  referenceNumber   String?
  performedBy       String
  createdAt         DateTime        @default(now())

  consumableItem  ConsumableItem   @relation(fields: [consumableItemId], references: [id], onDelete: Cascade)
  consumableBatch ConsumableBatch? @relation(fields: [consumableBatchId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [performedBy], references: [id])

  @@index([consumableItemId])
  @@index([consumableBatchId])
  @@index([createdAt])
}

model ConsumableRequest {
  id               String        @id @default(cuid())
  requestNumber    String        @unique
  consumableItemId String
  requesterId      String
  quantity         Int
  purpose          String?
  status           RequestStatus @default(PENDING)
  priority         Priority      @default(NORMAL)
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?
  releasedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  consumableItem ConsumableItem    @relation(fields: [consumableItemId], references: [id])
  requester      User              @relation("CreatedRequests", fields: [requesterId], references: [id])
  approver       User?             @relation("ApprovedRequests", fields: [approvedBy], references: [id])
  attachments    RequestAttachment[]

  @@index([requesterId])
  @@index([status])
  @@index([consumableItemId])
  @@index([createdAt])
}

model RequestAttachment {
  id         String   @id @default(cuid())
  requestId  String
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedBy String
  createdAt  DateTime @default(now())

  request ConsumableRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ✅ NEW MODEL: Tracks consumable stock owned by each user
// Created/incremented when a request is approved.
// Decremented when user records a distribution/use/transfer.
model UserConsumableInventory {
  id               String   @id @default(cuid())
  userId           String
  consumableItemId String
  quantity         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumableItem ConsumableItem @relation(fields: [consumableItemId], references: [id], onDelete: Cascade)
  distributions  UserDistribution[]

  @@unique([userId, consumableItemId])
  @@index([userId])
  @@index([consumableItemId])
}

// ✅ NEW MODEL: Records every time a user distributes, uses, or transfers
// an item out of their personal consumable inventory.
model UserDistribution {
  id            String               @id @default(cuid())
  inventoryId   String               // → UserConsumableInventory.id
  performedBy   String               // → User.id
  quantity      Int
  type          UserDistributionType
  recipientName String?
  recipientDept String?
  location      String?
  notes         String?
  createdAt     DateTime             @default(now())

  inventory UserConsumableInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [performedBy], references: [id])

  @@index([inventoryId])
  @@index([performedBy])
  @@index([createdAt])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  referenceId String?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum BatchStatus {
  ACTIVE
  DEPLETED
  EXPIRED
}

// ✅ NEW ENUM
enum UserDistributionType {
  DISTRIBUTED
  USED
  TRANSFERRED
}

enum Role {
  ADMIN
  MODERATOR
  USER
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum ItemCategory {
  ELECTRONICS
  FURNITURE
  VEHICLE
  EQUIPMENT
  TOOLS
  OFFICE_SUPPLIES
  MEDICAL
  OTHER
}

enum InventoryStatus {
  AVAILABLE
  ASSIGNED
  REPAIR
  LOST
  CONDEMNED
  ARCHIVED
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RETURN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  RELEASED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  LOW_STOCK
  EXPIRATION
  REQUEST_APPROVED
  REQUEST_REJECTED
  ITEM_ASSIGNED
  SYSTEM
}
